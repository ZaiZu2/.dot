{
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pyright *)",
      "Bash(uv run tox *)",
      "Bash(pytest *)",
      "Bash(tox *)",
      "Bash(npm test*)",
      "Bash(shellcheck *)",
      "Bash(shfmt -d *)",
      "Bash(stylua --check *)",
      "Bash(prettier --check *)",
      "Bash(npx prettier --check *)",
      "Bash(terraform fmt -check*)",
      "Bash(grep *)",
      "Bash(egrep *)",
      "Bash(fgrep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(ll *)",
      "Bash(fd *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(column *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(readlink *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(type *)",
      "Bash(command -v *)",
      "Bash(pwd)",
      "Bash(date *)",
      "Bash(gh pr *)",
      "Bash(gh repo view *)",
      "Bash(gh run *)",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(kubectl get *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl top *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl events *)",
      "Bash(kubectl cluster-info)",
      "Bash(kubectl cluster-info dump*)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl api-versions)",
      "Bash(kubectl version *)",
      "Bash(kubectl config view *)",
      "Bash(kubectl config get-contexts *)",
      "Bash(kubectl config current-context)",
      "Bash(kubectl config get-clusters)",
      "Bash(kubectl auth can-i *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:support.atlassian.com)",
      "WebSearch",
      "Bash(git commit -m *)"
    ],
    "deny": [
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf $HOME)",
      "Bash(sudo rm *)",
      "Bash(sudo /bin/rm *)",
      "Bash(sudo /usr/bin/rm *)",
      "Bash(dd *)",
      "Bash(sudo dd *)",
      "Bash(/bin/dd *)",
      "Bash(mkfs*)",
      "Bash(sudo mkfs*)",
      "Bash(shred *)",
      "Bash(sudo shred *)",
      "Bash(sudo chmod -R *)",
      "Bash(sudo chown -R *)",
      "Bash(> /dev/sda*)",
      "Bash(> /dev/nvme*)",
      "Bash(> /dev/disk*)",
      "Bash(mv * /dev/null*)",
      "Bash(mv */ /dev/null*)"
    ],
    "ask": [
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git checkout * -- *)",
      "Bash(git branch -D *)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove --force*)",
      "Bash(git worktree remove * -f*)",
      "Bash(git worktree remove * --force*)",
      "Bash(git clean *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm -f *)",
      "Bash(rm  *)",
      "Bash(rm\t*)",
      "Bash(rm --recursive*)",
      "Bash(rm --force*)",
      "Bash(rm -R*)",
      "Bash(/bin/rm *)",
      "Bash(/usr/bin/rm *)",
      "Bash(* rm -rf *)",
      "Bash(*&& rm *)",
      "Bash(*; rm *)",
      "Bash(*| rm *)",
      "Bash(*`rm *)",
      "Bash(xargs rm*)",
      "Bash(*xargs rm*)",
      "Bash(find * -delete*)",
      "Bash(find * -exec rm*)",
      "Bash(chmod -R *)",
      "Bash(chmod --recursive*)",
      "Bash(chown -R *)",
      "Bash(chown --recursive*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/commit-gate.sh"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-waiting-mark.sh mark"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "refreshInterval": 10
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "autoCompactEnabled": true
}
