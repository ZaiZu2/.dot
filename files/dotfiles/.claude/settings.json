{
    "env": {
        "AWS_REGION": "eu-west-1",
        "AWS_PROFILE": "dev",
        "ANTHROPIC_DEFAULT_OPUS_MODEL": "arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/xvfls0cjpliw",
        "ANTHROPIC_DEFAULT_SONNET_MODEL": "arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/qtkbfce6116o",
        "ANTHROPIC_DEFAULT_HAIKU_MODEL": "arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/idzo2cucprm0",
        "CLAUDE_CODE_USE_BEDROCK": "1"
    },
    "model": "opus",
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "/Users/AB0383Q/.claude/hooks/rtk-rewrite.sh"
                    }
                ]
            }
        ]
    },
    "alwaysThinkingEnabled": true,
    "effortLevel": "high",
    "statusLine": {
        "type": "command",
        "command": "~/.claude/statusline.sh"
    },
    "mcpServers": {
        "rag": {
            "command": "python3",
            "args": [
                "/Users/AB025UL/Documents/programs/ssh_tools/ai/mcp/servers/rag-mcp-server.py"
            ],
            "env": {},
            "description": "Prime Services RAG API — creds from macOS Keychain (service: prime-rag)"
        }
    },
    "permissions": {
        "allow": [
            "Bash(git fetch *)",
            "Bash(git worktree *)",
            "Bash(git add *)",
            "Bash(git status *)",
            "Bash(git show *)",
            "Bash(git log *)",
            "Bash(git diff *)",
            "Bash(git checkout *)",
            "Bash(git branch *)",

            "Bash(uv sync *)",
            "Bash(uv lock *)",
            "Bash(uv run pytest *)",
            "Bash(uv run ruff *)",

            "Bash(make *)",

            "Bash(gh pr *)",
            "Bash(gh run *)"
        ],
        "deny": [
            "Bash(git checkout -- *)",
            "Bash(git checkout .)",
            "Bash(git branch -D *)",
            "Bash(git clean *)",
            "Bash(git reset --hard *)",
            "Bash(git push --force*)",
            "Bash(git push -f *)",

            "Bash(rm -rf *)",
            "Bash(rm -fr *)",
            "Bash(rm -r *)",
            "Bash(rm -f *)",
            "Bash(rm  *)",
            "Bash(rm\t*)",
            "Bash(rm --recursive*)",
            "Bash(rm --force*)",
            "Bash(rm -R*)",
            "Bash(/bin/rm *)",
            "Bash(/usr/bin/rm *)",
            "Bash(sudo rm *)",
            "Bash(sudo /bin/rm *)",
            "Bash(sudo /usr/bin/rm *)",
            "Bash(* rm -rf *)",
            "Bash(*&& rm *)",
            "Bash(*; rm *)",
            "Bash(*| rm *)",
            "Bash(*`rm *)",
            "Bash(*$(rm *)",
            "Bash(xargs rm*)",
            "Bash(*xargs rm*)",
            "Bash(find * -delete*)",
            "Bash(find * -exec rm*)",

            "Bash(dd *)",
            "Bash(sudo dd *)",
            "Bash(/bin/dd *)",
            "Bash(mkfs*)",
            "Bash(sudo mkfs*)",
            "Bash(shred *)",
            "Bash(sudo shred *)",
            "Bash(chmod -R *)",
            "Bash(chmod --recursive*)",
            "Bash(sudo chmod -R *)",
            "Bash(chown -R *)",
            "Bash(chown --recursive*)",
            "Bash(sudo chown -R *)",

            "Bash(:(){ *)",
            "Bash(> /dev/sda*)",
            "Bash(> /dev/nvme*)",
            "Bash(> /dev/disk*)",
            "Bash(mv * /dev/null*)",
            "Bash(mv */ /dev/null*)"
        ]
    }
}
