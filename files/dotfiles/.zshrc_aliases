#!/bin/zsh

zoxide_interactive() {
    local result=$(zoxide query --interactive)
    if [[ -n $result ]]; then
        BUFFER="cd $result"
        zle accept-line
    fi
}
zle -N zoxide_interactive
bindkey '^G' zoxide_interactive

for i in {2..6}; do
    alias "$(printf '.%.0s' {1..$i})=cd ..$(printf '/..%.0s' {1..$i})"
done

alias n='nvim'

# claude ──HTTP──▶ headroom :8787 ──SigV4──▶ Bedrock.
# CLAUDE_CODE_USE_BEDROCK is unset so Claude Code speaks HTTP (proxyable) instead
# of boto3 direct; the proxy signs Bedrock on the outbound leg. `bedrock/` prefix
# on the ARNs is required by litellm's provider router.
c() {
    local port=8787
    local region="${AWS_REGION:-eu-west-1}"
    if curl -fsS "http://127.0.0.1:${port}/health" >/dev/null 2>&1; then
        echo "Reusing Headroom proxy already running on :${port}"
    else
        echo "Starting Headroom proxy on :${port} (backend=bedrock region=${region})..."
        uvx --with boto3 --from 'headroom-ai[proxy]' headroom proxy \
            --backend bedrock --region "$region" --port "$port" \
            >/tmp/headroom-proxy.log 2>&1 &
        local pid=$!
        for _ in {1..60}; do
            curl -fsS "http://127.0.0.1:${port}/health" >/dev/null 2>&1 && break
            sleep 0.5
        done
        curl -fsS "http://127.0.0.1:${port}/health" >/dev/null 2>&1 || {
            echo "Headroom proxy failed to start (see /tmp/headroom-proxy.log)" >&2
            kill "$pid" 2>/dev/null
            return 1
        }
    fi
    # Claude Code talks HTTP to the proxy; the proxy signs Bedrock calls with the
    # inference-profile ARNs below. `bedrock/` prefix is required by litellm's router.
    CLAUDE_CODE_USE_BEDROCK="" \
        ANTHROPIC_BASE_URL="http://127.0.0.1:${port}" \
        ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-dummy}" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="bedrock/arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/xvfls0cjpliw" \
        ANTHROPIC_DEFAULT_SONNET_MODEL="bedrock/arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/qtkbfce6116o" \
        ANTHROPIC_DEFAULT_HAIKU_MODEL="bedrock/arn:aws:bedrock:eu-west-1:843931780115:application-inference-profile/idzo2cucprm0" \
        claude "$@"
}
