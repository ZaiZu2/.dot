# Fuzzy-pick a worktree in the current repo and cd into it.
gw() {
    git rev-parse --git-dir >/dev/null 2>&1 || {
        echo "Not in a git repo" >&2
        return 1
    }
    [ $(git worktree list | wc -l) -le 1 ] && {
        echo "Only current worktree exists" >&2
        return 1
    }
    cd "$(git worktree list | \fzf --height 40% --reverse | awk '{print $1}')"
}
alias gwl='git worktree list'

# Add a worktree for <branch> (creates it off origin/HEAD if new), cd in, uv sync.
gwa() {
    local new_branch="$1"
    local new_branch_exists=$(git branch -a --list "$new_branch" "*/$new_branch")

    local master_branch=$(git symbolic-ref --short refs/remotes/origin/HEAD)
    local master_branch="${master_branch##*\/}" # strip `origin/`
    local base_branch="${2:-$master_branch}"

    local repo_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
    local worktree_path="$repo_dir/${new_branch//\//-}" # replace all `/` with `-`

    if [ -z "$new_branch_exists" ]; then
        git worktree add "$worktree_path" -b "$new_branch" "$base_branch" || return 1
    else
        git worktree add "$worktree_path" "$new_branch" || return 1
    fi
    cd "$(git worktree list | grep "$new_branch" | awk '{print $1}')"
    uv sync --quiet || return 1
}
_gwa_completion() {
    git rev-parse --git-dir >/dev/null 2>&1 || return 1
    local branches=($(git branch -a 2>/dev/null | sed 's/^[* ]*//' | grep -v 'HEAD' | sed 's|remotes/[^/]*/||' | sort -u))
    _values 'branches' "${branches[@]}"
}

# Remove worktree named <name> (defaults to cwd); -f/--force to discard changes.
gwr() {
    local force=0
    local worktree_name=""
    for arg in "$@"; do
        case "$arg" in
        -f | --force) force=1 ;;
        *) worktree_name="$arg" ;;
        esac
    done
    local current_dir="$(basename $(pwd))"
    local worktree_name="${worktree_name:-$current_dir}"
    local repo_dir="$(git rev-parse --path-format=absolute --git-common-dir)"
    local worktree_path="$(git worktree list | grep "$worktree_name" | awk '{print $1}')"
    [ -z "$worktree_path" ] && {
        echo "Worktree '$worktree_name' does not exist"
        return 1
    }

    if [ "$force" -eq 1 ]; then
        git worktree remove --force "$worktree_path" || return 1
    else
        git worktree remove "$worktree_path" || return 1
    fi
    [ "$worktree_path" = "$(pwd)" ] && cd "$repo_dir"
}
_gwr_completion() {
    git rev-parse --git-dir >/dev/null 2>&1 || return 1
    local worktrees=($(git worktree list 2>/dev/null | awk 'NR>1 {print $1}' | xargs -I {} basename {}))
    _values 'worktrees' "${worktrees[@]}"
}

_register_completions() {
    compdef _gwr_completion gwr
    compdef _gwa_completion gwa
    add-zsh-hook -d precmd _register_completions
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _register_completions
